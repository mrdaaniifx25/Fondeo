//@version=5
// Estrategia de docs/ESTRATEGIA_operativa.md, apartado a apartado.
// Barrido del rango de Asia dentro de la ventana de Londres. EURUSD, M15.
//
// NO REPINTA: la senal se evalua al CIERRE de la vela (barstate.isconfirmed)
// y la entrada es en la APERTURA de la vela siguiente.
indicator("CRT Londres · barrido de Asia", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ───────────────────────────── parametros ─────────────────────────────
tz        = input.string("Europe/Madrid", "Huso horario")
asiaIni   = input.int(0,   "Asia · hora inicio",     minval = 0, maxval = 23)
asiaFin   = input.int(8,   "Asia · hora fin",        minval = 1, maxval = 24)
opIni     = input.int(8,   "Ventana · hora inicio",  minval = 0, maxval = 23)
opFin     = input.int(11,  "Ventana · hora fin",     minval = 1, maxval = 24)
kATR      = input.float(1.5, "Riesgo = k x ATR(14)", minval = 0.1, step = 0.1)
rr        = input.float(2.0, "Objetivo = R:R",       minval = 0.1, step = 0.1)
maxOps    = input.int(3,   "Máximo de operaciones al día",   minval = 1)
maxPerd   = input.int(2,   "Parar tras N pérdidas seguidas", minval = 1)
horasVida = input.int(6,   "Cierre forzoso a las N horas",   minval = 1)
capital   = input.float(10000, "Saldo de la cuenta",         minval = 1)
pctRiesgo = input.float(0.50,  "Riesgo por operación (%)",   minval = 0.01, step = 0.05)
costeR    = input.float(0.10,  "Coste en R (horquilla/stop)", minval = 0,   step = 0.01)
contrato  = input.float(100000, "Tamaño del contrato",       minval = 1)

// ───────────────────────────── reloj ─────────────────────────────
h        = hour(time, tz)
nuevoDia = dayofmonth(time, tz) != dayofmonth(time[1], tz)
enAsia   = h >= asiaIni and h < asiaFin
enVent   = h >= opIni   and h < opFin

// ──────────────────── rango de Asia del propio dia ────────────────────
var float asiaH = na
var float asiaL = na
var box   caja  = na
if nuevoDia
    asiaH := na
    asiaL := na
    caja  := box.new(bar_index, high, bar_index, low,
         border_color = color.new(color.gray, 40), bgcolor = color.new(color.gray, 92))
if enAsia
    asiaH := na(asiaH) ? high : math.max(asiaH, high)
    asiaL := na(asiaL) ? low  : math.min(asiaL, low)
    if not na(caja)
        box.set_top(caja, asiaH)
        box.set_bottom(caja, asiaL)
        box.set_right(caja, bar_index)

bgcolor(enVent ? color.new(color.blue, 93) : na, title = "Ventana de Londres")
plot(enVent and not na(asiaH) ? asiaH : na, "Asia máximo", color.red,  1, plot.style_linebr)
plot(enVent and not na(asiaL) ? asiaL : na, "Asia mínimo", color.teal, 1, plot.style_linebr)

// ──────────────────────── contadores del dia ────────────────────────
var int  opsHoy    = 0
var int  perdSegui = 0
var bool hechoL    = false
var bool hechoC    = false
if nuevoDia
    opsHoy    := 0
    perdSegui := 0
    hechoL    := false
    hechoC    := false

puede = enVent and opsHoy < maxOps and perdSegui < maxPerd and not na(asiaH) and not na(asiaL)

// ───────────── la senal · apartado 4 de la especificacion ─────────────
corto = puede and not hechoC and high >= asiaH and close < asiaH and low  > asiaL
largo = puede and not hechoL and low  <= asiaL and close > asiaL and high < asiaH

// ───────────────────────── estado interno ─────────────────────────
var int   pend    = 0          // orden pendiente: +1 compra, -1 venta
var float pendRgo = na
var int   lado    = 0          // operacion viva
var float ent     = na
var float sl      = na
var float tp      = na
var int   barEnt  = na
var line  lnSL    = na
var line  lnTP    = na
var int   nOps    = 0
var int   nGan    = 0
var float sumR    = 0.0

atr      = ta.atr(14)
barrasVida = math.max(1, math.round(horasVida * 3600 / timeframe.in_seconds()))

// ── 1 · resolver la operacion viva ANTES de abrir otra ──
if lado != 0
    line.set_x2(lnSL, bar_index)
    line.set_x2(lnTP, bar_index)
    golpeSL = lado > 0 ? low  <= sl : high >= sl
    golpeTP = lado > 0 ? high >= tp : low  <= tp
    float rOp = na
    if golpeSL                              // empate dentro de la vela = pérdida
        rOp := -1.0 - costeR
    else if golpeTP
        rOp := rr - costeR
    else if bar_index - barEnt >= barrasVida
        rOp := (close - ent) / (ent - sl) - costeR
    if not na(rOp)
        nOps += 1
        sumR += rOp
        if rOp > 0
            nGan      += 1
            perdSegui := 0
        else
            perdSegui += 1
        lado := 0

// ── 2 · ejecutar la pendiente en la APERTURA de esta vela ──
if pend != 0 and lado == 0
    ent    := open
    sl     := pend > 0 ? ent - pendRgo : ent + pendRgo
    tp     := pend > 0 ? ent + rr * pendRgo : ent - rr * pendRgo
    lado   := pend
    barEnt := bar_index
    opsHoy := opsHoy + 1
    lnSL := line.new(bar_index, sl, bar_index, sl, color = color.red,  width = 2)
    lnTP := line.new(bar_index, tp, bar_index, tp, color = color.teal, width = 2)
    lotes = capital * pctRiesgo / 100.0 / (pendRgo * contrato)
    pips  = pendRgo / syminfo.mintick / 10.0
    label.new(bar_index, pend > 0 ? sl : tp,
         (pend > 0 ? "COMPRA " : "VENTA ") + str.tostring(lotes, "#.##") + " lotes" +
         "\nent " + str.tostring(ent, format.mintick) +
         "\nSL  " + str.tostring(sl,  format.mintick) +
         "\nTP  " + str.tostring(tp,  format.mintick) +
         "\nriesgo " + str.tostring(pips, "#.#") + " p",
         style     = pend > 0 ? label.style_label_up : label.style_label_down,
         color     = color.new(pend > 0 ? color.teal : color.red, 20),
         textcolor = color.white, size = size.small)
    pend := 0

// ── 3 · registrar la senal de ESTA vela para entrar en la siguiente ──
if barstate.isconfirmed and lado == 0 and pend == 0
    if corto
        pend    := -1
        pendRgo := kATR * atr
        hechoC  := true
    else if largo
        pend    := 1
        pendRgo := kATR * atr
        hechoL  := true

plotshape(corto, "Señal venta",  shape.triangledown, location.abovebar, color.red,  size = size.tiny)
plotshape(largo, "Señal compra", shape.triangleup,   location.belowbar, color.teal, size = size.tiny)

// ───────────────────────────── tabla ─────────────────────────────
var table t = table.new(position.top_right, 2, 7, border_width = 1,
     bgcolor = color.new(color.black, 20))
if barstate.islast
    acierto = nOps > 0 ? 100.0 * nGan / nOps : 0.0
    umbral  = 100.0 * (1.0 + costeR) / (1.0 + rr)
    cOk     = acierto >= umbral ? color.teal : color.red
    cR      = sumR >= 0 ? color.teal : color.red
    table.cell(t, 0, 0, "operaciones",   text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 0, str.tostring(nOps), text_color = color.white, text_size = size.small)
    table.cell(t, 0, 1, "acierto",       text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, str.tostring(acierto, "#.#") + " %", text_color = cOk, text_size = size.small)
    table.cell(t, 0, 2, "umbral",        text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 2, str.tostring(umbral, "#.#") + " %", text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 3, "R neta total",  text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, str.tostring(sumR, "#.##"), text_color = cR, text_size = size.small)
    table.cell(t, 0, 4, "R por op.",     text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 4, nOps > 0 ? str.tostring(sumR / nOps, "#.###") : "—", text_color = cR, text_size = size.small)
    table.cell(t, 0, 5, "ops hoy",       text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 5, str.tostring(opsHoy) + " / " + str.tostring(maxOps),
         text_color = opsHoy >= maxOps ? color.red : color.white, text_size = size.small)
    table.cell(t, 0, 6, "pérdidas seg.", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 6, str.tostring(perdSegui) + " / " + str.tostring(maxPerd),
         text_color = perdSegui >= maxPerd ? color.red : color.white, text_size = size.small)

alertcondition(corto, "Venta · barrido del máximo de Asia",
     "VENTA EURUSD · entrar en la APERTURA de la vela siguiente")
alertcondition(largo, "Compra · barrido del mínimo de Asia",
     "COMPRA EURUSD · entrar en la APERTURA de la vela siguiente")
