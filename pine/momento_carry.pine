//@version=6
// ============================================================================
//  MOMENTO Y CARRY  ·  senal mensual
//
//  Calcula la mitad de MOMENTO de la estrategia (precio contra el de hace 1, 3,
//  6 y 12 meses) y la combina con el CARRY, que introduces tu a mano leyendo el
//  swap de tu broker.  Te da la direccion, el tamanio en lotes y te avisa
//  cuando cambia.
//
//  NO es un indicador de entrada intradia.  La senal solo cambia al cerrar el
//  mes y usa SOLO meses cerrados: no repinta.
//
//  Medido en docs/RESULTADOS_momento_largo.md y docs/RESULTADOS_carry.md
// ============================================================================
indicator("Momento y Carry", shorttitle="MomCarry", overlay=false, precision=2)

// ---------------------------------------------------------------- parametros
grpS = "Senal"
umbral = input.float(0.25, "Umbral minimo |senal|", minval=0.0, maxval=1.0, step=0.05,
     tooltip="Por debajo de este valor no se abre posicion. El sistema usa 0,25.", group=grpS)
carry  = input.int(0, "Carry (de tu broker)", minval=-1, maxval=1,
     tooltip="Mira el swap de este par en tu MT5. Ordena los 12 pares por swap:\n" +
             "  +1  si esta en el tercio que MAS te paga\n" +
             "   0  si esta en el tercio de en medio\n" +
             "  -1  si esta en el tercio que MAS te cobra", group=grpS)

grpT = "Tamanio"
cuenta = input.float(25000, "Tamanio de la cuenta", minval=100, step=1000, group=grpT)
riesgo = input.float(0.25, "Riesgo por posicion (%)", minval=0.01, step=0.05,
     tooltip="0,25 % = escala 1x (la tranquila).  1,00 % = escala 4x (la agresiva).", group=grpT)
lotemin= input.float(0.01, "Lote minimo del broker", minval=0.001, step=0.001, group=grpT)

// --------------------------------------------------- calculo sobre el MENSUAL
// Se pide [1] para usar solo meses CERRADOS. Con lookahead_off no repinta.
f_momento() =>
    s  = (close > close[1]  ? 1.0 : -1.0)
    s += (close > close[3]  ? 1.0 : -1.0)
    s += (close > close[6]  ? 1.0 : -1.0)
    s += (close > close[12] ? 1.0 : -1.0)
    s / 4.0

f_sigma() =>
    ta.stdev(math.log(close / close[1]), 36)

momento = request.security(syminfo.tickerid, "M", f_momento()[1], lookahead=barmerge.lookahead_off)
sigma   = request.security(syminfo.tickerid, "M", f_sigma()[1],   lookahead=barmerge.lookahead_off)

senal_bruta = (momento + carry) / 2.0
senal = math.abs(senal_bruta) < umbral ? 0.0 : senal_bruta

// ------------------------------------------------------------------- tamanio
nocional = na(sigma) or sigma <= 0 ? na : cuenta * (riesgo / 100.0) * math.abs(senal) / sigma
lotes    = na(nocional) ? na : nocional / 100000.0
cabe     = not na(lotes) and lotes >= lotemin / 2.0

// ------------------------------------------------------------------- dibujos
col = senal > 0 ? color.new(#0b6e4f, 0) : senal < 0 ? color.new(#a83318, 0) : color.new(#8b96a3, 0)
plot(senal, "Senal", color=col, style=plot.style_columns, linewidth=3)
hline( umbral, "umbral +", color=color.new(#8b96a3, 55), linestyle=hline.style_dashed)
hline(-umbral, "umbral -", color=color.new(#8b96a3, 55), linestyle=hline.style_dashed)
hline(0, "", color=color.new(#8b96a3, 30))
plot(momento, "Solo momento", color=color.new(#1d5cba, 35), linewidth=1)
bgcolor(senal != 0 ? color.new(senal > 0 ? #0b6e4f : #a83318, 93) : na)

// -------------------------------------------------------------------- tabla
var table t = table.new(position.top_right, 2, 7, border_width=1,
     frame_color=color.new(#8b96a3, 60), frame_width=1)
f_fila(fila, k, v, c) =>
    table.cell(t, 0, fila, k, text_size=size.small, text_halign=text.align_left,
         text_color=color.new(#8b96a3, 0), bgcolor=color.new(#ffffff, 100))
    table.cell(t, 1, fila, v, text_size=size.small, text_halign=text.align_right,
         text_color=c, bgcolor=color.new(#ffffff, 100))

if barstate.islast
    dir = senal > 0 ? "COMPRAR" : senal < 0 ? "VENDER" : "FUERA"
    table.cell(t, 0, 0, syminfo.ticker, text_size=size.normal, text_halign=text.align_left,
         text_color=color.new(#131920, 0), bgcolor=color.new(#ffffff, 100))
    table.cell(t, 1, 0, dir, text_size=size.normal, text_halign=text.align_right,
         text_color=col, bgcolor=color.new(#ffffff, 100))
    f_fila(1, "momento",  str.tostring(momento, "+0.00"), color.new(#131920, 0))
    f_fila(2, "carry",    str.tostring(carry,   "+0"),    color.new(#131920, 0))
    f_fila(3, "SENAL",    str.tostring(senal,   "+0.00"), col)
    f_fila(4, "sigma mes", str.tostring(sigma * 100, "0.00") + " %", color.new(#131920, 0))
    f_fila(5, "nocional", str.tostring(nocional, "#,###"), color.new(#131920, 0))
    f_fila(6, "LOTES", senal == 0 ? "—" :
         cabe ? str.tostring(math.round(lotes / lotemin) * lotemin, "0.00")
              : "no llega al minimo",
         cabe or senal == 0 ? color.new(#131920, 0) : color.new(#a83318, 0))

// -------------------------------------------------------------------- avisos
mes_nuevo = ta.change(time("M")) != 0
giro      = ta.change(math.sign(senal)) != 0

alertcondition(mes_nuevo and giro and senal > 0,
     "Cambio a COMPRA", "MomCarry: {{ticker}} pasa a COMPRA. Recalcula lotes y ajusta.")
alertcondition(mes_nuevo and giro and senal < 0,
     "Cambio a VENTA",  "MomCarry: {{ticker}} pasa a VENTA. Recalcula lotes y ajusta.")
alertcondition(mes_nuevo and giro and senal == 0,
     "Salir del par",   "MomCarry: {{ticker}} se queda FUERA. Cierra la posicion.")
alertcondition(mes_nuevo,
     "Cierre de mes",   "MomCarry: mes cerrado en {{ticker}}. Toca revisar los 12 pares.")

plotshape(mes_nuevo and giro, "Giro", shape.diamond, location.bottom,
     color=col, size=size.tiny)
