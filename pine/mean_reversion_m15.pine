//@version=6
// ============================================================================
//  REVERSION A LA MEDIA · EUR/USD M15
//  Reglas y numeros: docs/MEAN_REVERSION_REGLAS.md · docs/RESULTADOS_mr_reglas.md
//
//  QUE HACE
//    - Marca la vela de señal y calcula entrada, stop y objetivo.
//    - Lleva la cuenta de las PERDIDAS SEGUIDAS del dia y cierra el dia a las 2.
//    - Lanza alerta de COMPRA y de VENTA con los niveles ya calculados.
//
//  NO REPINTA
//    La señal se evalua sobre la vela YA CERRADA (todo con [1]) y la entrada es
//    la APERTURA de la vela actual. Nada se decide con una vela en formacion.
//
//  CONFIGURA LA ALERTA EN "Una vez por barra", NO "al cierre de la barra".
//    La entrada es en la apertura, asi que el aviso tiene que llegar al abrir.
//
//  ESPERANZA CERO. Esto no tiene ventaja medida: neto -0,090 pips por
//  operacion con un coste de 0,7. Lo que aporta es la gestion: 38,1 % de pasar
//  las dos fases con 0,0 % de muerte por limite diario. Mide antes el coste
//  real de tu broker: por encima de 0,7 pips esto pierde dinero.
// ============================================================================

indicator("Reversion a la media · M15", overlay = true)

// ---------------------------------------------------------------- parametros
gS         = "Señal"
longBB     = input.int(20,    "Bollinger · longitud",      group = gS)
multBB     = input.float(1.5, "Bollinger · desviaciones",  group = gS, step = 0.1)
longEMA    = input.int(20,    "EMA del objetivo",          group = gS)
longRSI    = input.int(14,    "RSI · longitud",            group = gS)
umbralBajo = input.int(30,    "RSI · umbral de compra",    group = gS)
umbralAlto = input.int(70,    "RSI · umbral de venta",     group = gS)

gG         = "Gestion"
stopPips   = input.float(15.0, "Stop (pips)",              group = gG, step = 0.5)
topeBarras = input.int(64,     "Tope de vida en velas (64 = 16 h)", group = gG)
maxPerd    = input.int(2,      "Parar el dia tras N perdidas seguidas", group = gG)
tamPip     = input.float(0.0001, "Tamaño del pip", group = gG, step = 0.0001, tooltip = "0,0001 en pares de 4-5 decimales. 0,01 en pares con JPY.")

gD         = "Dinero"
capital    = input.float(10000.0, "Capital de la cuenta",    group = gD)
riesgoPct  = input.float(1.0,     "Riesgo por operacion (%)", group = gD, step = 0.05)
valorPip   = input.float(10.0,    "Valor del pip por lote",  group = gD, tooltip = "En la divisa de tu cuenta. ~10 en EURUSD con cuenta en USD.")

gV         = "Vista"
verBandas  = input.bool(true, "Dibujar bandas y EMA",        group = gV)
verNiv     = input.bool(true, "Dibujar niveles de la operacion viva", group = gV)
verTabla   = input.bool(true, "Tabla de estado",             group = gV)

// -------------------------------------------------------------- indicadores
// ta.stdev de Pine usa la desviacion POBLACIONAL; el backtest usa la MUESTRAL
// (pandas .std(), ddof=1). El factor sqrt(n/(n-1)) las iguala. Sin esto las
// bandas salen un 2,6 % mas estrechas y las señales NO son las mismas.
desvPobl  = ta.stdev(close, longBB)
desvMues  = desvPobl * math.sqrt(longBB / (longBB - 1.0))
base      = ta.sma(close, longBB)
bandaAlta = base + multBB * desvMues
bandaBaja = base - multBB * desvMues
emaObj    = ta.ema(close, longEMA)
valorRSI  = ta.rsi(close, longRSI)
medioVela = (high + low) / 2.0
riesgoEur = capital * riesgoPct / 100.0
lotes     = (valorPip > 0 and stopPips > 0) ? (riesgoEur / (stopPips * valorPip)) : na

// --------------------------------------------------- las cuatro condiciones
crudoCompra = low < bandaBaja and valorRSI < umbralBajo and close > open and close > medioVela
crudoVenta  = high > bandaAlta and valorRSI > umbralAlto and close < open and close < medioVela

// ------------------------------------------------------------------- estado
var int   posicion    = 0
var float precioEnt   = na
var float nivelStop   = na
var float nivelObj    = na
var int   barraEnt    = 0
var int   perdidasDia = 0
var int   opsDia      = 0

diaMadrid = dayofmonth(time, "Europe/Madrid")
nuevoDia  = diaMadrid != diaMadrid[1]
if nuevoDia
    perdidasDia := 0
    opsDia := 0
// estado al EMPEZAR la vela, para saber si el dia se cierra justo ahora
bool eraCerrado = perdidasDia >= maxPerd

// --- 1) resolver PRIMERO la operacion abierta de velas anteriores ----------
// El orden importa: se cierra lo que haya antes de mirar si hay señal nueva.
// Al reves se solaparian posiciones.
float cerradoR = na
if posicion != 0 and barraEnt < bar_index
    bool tocaStop = (posicion > 0) ? (low <= nivelStop) : (high >= nivelStop)
    bool tocaObj  = (posicion > 0) ? (high >= nivelObj) : (low <= nivelObj)
    bool venceT   = (bar_index - barraEnt) >= topeBarras
    if tocaStop
        // empate stop/objetivo en la misma vela: PERDIDA, igual que el backtest
        cerradoR := -stopPips
        posicion := 0
    else if tocaObj
        cerradoR := math.abs(nivelObj - precioEnt) / tamPip
        posicion := 0
    else if venceT
        cerradoR := (close - precioEnt) * ((posicion > 0) ? 1.0 : -1.0) / tamPip
        posicion := 0

// --- 1b) la racha se actualiza YA, antes de mirar si hay entrada ----------
// Si el cierre de arriba es la segunda perdida seguida, el dia queda cerrado
// para ESTA vela tambien. Hacerlo despues dejaria colar una entrada de mas.
if not na(cerradoR)
    perdidasDia := (cerradoR <= 0) ? (perdidasDia + 1) : 0

// --- 2) ¿hay entrada en la APERTURA de esta vela? --------------------------
// Se mira la vela ANTERIOR, que ya esta cerrada. La entrada es el open de ahora.
bool diaCerradoAntes = perdidasDia >= maxPerd
// posicion[1] == 0 exige que NO hubiera nada abierto cuando cerro la vela de
// la señal. Sin esto se tomarian señales nacidas con una posicion viva, que el
// backtest descarta.
bool hayCompra = crudoCompra[1] and posicion == 0 and posicion[1] == 0 and not diaCerradoAntes
bool hayVenta  = crudoVenta[1]  and posicion == 0 and posicion[1] == 0 and not diaCerradoAntes

float entTeor = open
float objTeor = emaObj[1]
// el objetivo tiene que estar al menos a 1 pip y en el lado correcto
bool validaC = hayCompra and (objTeor - entTeor) > tamPip
bool validaV = hayVenta  and (entTeor - objTeor) > tamPip

if validaC
    posicion := 1
    precioEnt := entTeor
    nivelStop := entTeor - stopPips * tamPip
    nivelObj := objTeor
    barraEnt := bar_index
    opsDia := opsDia + 1
else if validaV
    posicion := -1
    precioEnt := entTeor
    nivelStop := entTeor + stopPips * tamPip
    nivelObj := objTeor
    barraEnt := bar_index
    opsDia := opsDia + 1

// --- 3) la operacion puede resolverse en SU PROPIA vela de entrada ---------
// El backtest resuelve desde el primer minuto de la vela de entrada, asi que
// hay que mirarla tambien aqui. Sin esto se perderian los stops del mismo dia
// que luego se recuperan, y las cuentas no cuadrarian.
float cerradoR2 = na
if posicion != 0 and barraEnt == bar_index
    bool tocaStop2 = (posicion > 0) ? (low <= nivelStop) : (high >= nivelStop)
    bool tocaObj2  = (posicion > 0) ? (high >= nivelObj) : (low <= nivelObj)
    if tocaStop2
        cerradoR2 := -stopPips
        posicion := 0
    else if tocaObj2
        cerradoR2 := math.abs(nivelObj - precioEnt) / tamPip
        posicion := 0

// --- 4) actualizar la racha con lo que se haya cerrado en su propia vela ---
if not na(cerradoR2)
    perdidasDia := (cerradoR2 <= 0) ? (perdidasDia + 1) : 0

bool diaCerrado = perdidasDia >= maxPerd
float pipsObj = (na(nivelObj) or na(precioEnt)) ? na : (math.abs(nivelObj - precioEnt) / tamPip)

// -------------------------------------------------------------------- dibujo
plot(verBandas ? bandaAlta : na, "Banda alta", color = color.new(color.gray, 40))
plot(verBandas ? bandaBaja : na, "Banda baja", color = color.new(color.gray, 40))
plot(verBandas ? emaObj : na,    "EMA 20",     color = color.new(color.orange, 0), linewidth = 2)

plotshape(crudoCompra, "Señal de compra", shape.triangleup,   location.belowbar, color.new(color.teal, 0),   size = size.tiny)
plotshape(crudoVenta,  "Señal de venta",  shape.triangledown, location.abovebar, color.new(color.maroon, 0), size = size.tiny)
plotshape(validaC, "Entrada larga", shape.labelup,   location.belowbar, color.new(color.teal, 0),   text = "C", textcolor = color.white, size = size.small)
plotshape(validaV, "Entrada corta", shape.labeldown, location.abovebar, color.new(color.maroon, 0), text = "V", textcolor = color.white, size = size.small)

plot((verNiv and posicion != 0) ? precioEnt : na, "Entrada",  color = color.new(color.blue, 0),  style = plot.style_linebr)
plot((verNiv and posicion != 0) ? nivelStop : na, "Stop",     color = color.new(color.red, 0),   style = plot.style_linebr)
plot((verNiv and posicion != 0) ? nivelObj : na,  "Objetivo", color = color.new(color.green, 0), style = plot.style_linebr)

bgcolor(diaCerrado ? color.new(color.red, 92) : na, title = "Dia cerrado")

// --------------------------------------------------------------------- tabla
var table t = table.new(position.top_right, 2, 7, border_width = 1)
if verTabla and barstate.islast
    string estadoTxt = diaCerrado ? "DIA CERRADO" : ((posicion > 0) ? "LARGO" : ((posicion < 0) ? "CORTO" : "esperando"))
    color  estadoCol = diaCerrado ? color.new(color.red, 20) : ((posicion != 0) ? color.new(color.blue, 30) : color.new(color.gray, 40))
    color  fondo     = color.new(color.black, 70)
    table.cell(t, 0, 0, "Estado",            bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, estadoTxt,           bgcolor = estadoCol, text_color = color.white, text_size = size.small)
    table.cell(t, 0, 1, "Perdidas seguidas", bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 1, 1, str.tostring(perdidasDia) + " de " + str.tostring(maxPerd), bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 0, 2, "Operaciones hoy",   bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 1, 2, str.tostring(opsDia), bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 0, 3, "Entrada",           bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 1, 3, (posicion != 0) ? str.tostring(precioEnt, format.mintick) : "—", bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 0, 4, "Stop",              bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 1, 4, (posicion != 0) ? str.tostring(nivelStop, format.mintick) : "—", bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 0, 5, "Objetivo",          bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 1, 5, (posicion != 0) ? (str.tostring(nivelObj, format.mintick) + "  (" + str.tostring(pipsObj, "#.0") + " p)") : "—", bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 0, 6, "Lotes",             bgcolor = fondo, text_color = color.white, text_size = size.small)
    table.cell(t, 1, 6, str.tostring(lotes, "#.##"), bgcolor = fondo, text_color = color.white, text_size = size.small)

// ------------------------------------------------------------------- alertas
// A) alertcondition: salen en la lista de condiciones al crear la alerta.
alertcondition(validaC, "COMPRA · reversion a la media", "COMPRA EURUSD M15 · entra a precio de apertura · stop 15 pips · objetivo la EMA20 de la vela de señal")
alertcondition(validaV, "VENTA · reversion a la media",  "VENTA EURUSD M15 · entra a precio de apertura · stop 15 pips · objetivo la EMA20 de la vela de señal")
alertcondition(validaC or validaV, "COMPRA o VENTA", "Señal de reversion a la media en EURUSD M15")

// B) alert(): manda los NIVELES ya calculados. Al crear la alerta, elige
//    "Cualquier llamada a la funcion alert()".
if validaC
    alert("COMPRA " + syminfo.ticker + "  entrada " + str.tostring(precioEnt, format.mintick) + "  stop " + str.tostring(nivelStop, format.mintick) + "  objetivo " + str.tostring(nivelObj, format.mintick) + " (" + str.tostring(pipsObj, "#.0") + " pips)  lotes " + str.tostring(lotes, "#.##"), alert.freq_once_per_bar)
if validaV
    alert("VENTA " + syminfo.ticker + "  entrada " + str.tostring(precioEnt, format.mintick) + "  stop " + str.tostring(nivelStop, format.mintick) + "  objetivo " + str.tostring(nivelObj, format.mintick) + " (" + str.tostring(pipsObj, "#.0") + " pips)  lotes " + str.tostring(lotes, "#.##"), alert.freq_once_per_bar)
if diaCerrado and not eraCerrado
    alert("DIA CERRADO · " + str.tostring(maxPerd) + " perdidas seguidas. Cierra la plataforma hasta maniana.", alert.freq_once_per_bar)
