// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// at https://mozilla.org/MPL/2.0/
//
//  Asia · alto y mínimo, histórico completo
//
//  Dibuja el máximo y el mínimo de la sesión de Asia de cada día, desde el
//  principio del histórico que cargue el gráfico. Usa plot en vez de cajas o
//  líneas, así que NO tiene el límite de 500 objetos: si el gráfico carga
//  cinco años, se dibujan cinco años.
//
//  El nivel aparece cuando Asia CIERRA, no mientras se forma. Antes de esa
//  hora el máximo todavía puede subir, así que pintarlo sería enseñar algo
//  que en directo no sabrías.
//
//  Las etiquetas con los números sí están limitadas por TradingView, así que
//  se dibujan sólo en los últimos N días (ajustable).
//@version=6
indicator("Asia · histórico", overlay = true, max_labels_count = 500)

// ─── ajustes ──────────────────────────────────────────────────────────────
gA = "Sesión"
tz     = input.string("Europe/Madrid", "Huso horario", group = gA,
     options = ["Europe/Madrid", "Europe/London", "America/New_York", "UTC"],
     tooltip = "Con Europe/Madrid la sesión cae a la misma hora de tu reloj en " +
     "invierno y en verano.")
hIni   = input.int(0, "Asia empieza a las", 0, 23, group = gA)
hFin   = input.int(8, "Asia acaba a las",   1, 23, group = gA,
     tooltip = "El nivel se fija a esta hora y se dibuja desde aquí hasta la " +
     "siguiente sesión.")
soloLV = input.bool(true, "Sólo de lunes a viernes", group = gA)

gD = "Dibujo"
cAlto  = input.color(#B07D18,           "Color del alto",   inline = "c", group = gD)
cBajo  = input.color(#B07D18,           "Color del mínimo", inline = "c", group = gD)
grosor = input.int(1, "Grosor", 1, 4, group = gD)
verMed = input.bool(false, "Marcar también el 50 % del rango", group = gD)

gE = "Etiquetas"
verEtq = input.bool(true, "Escribir los números", group = gE)
nEtq   = input.int(60, "Días con etiqueta", 1, 240, group = gE,
     tooltip = "TradingView admite 500 etiquetas. Cada día gasta una, así que " +
     "con 60 vas sobrado para comprobar un par de meses.")
tamEtq = input.string("Pequeño", "Tamaño", options = ["Diminuto", "Pequeño", "Normal"], group = gE)
verRango = input.bool(true, "Añadir el rango en pips", group = gE)

// ─── tamaño del pip ───────────────────────────────────────────────────────
dig = math.round(-math.log10(syminfo.mintick))
pip = (dig == 5 or dig == 3) ? syminfo.mintick * 10 : syminfo.mintick

// ─── ¿estamos en Asia? ────────────────────────────────────────────────────
h    = hour(time, tz)
dSem = dayofweek(time, tz)
habil = not soloLV or (dSem != dayofweek.saturday and dSem != dayofweek.sunday)
enAsia = habil and (hIni < hFin ? (h >= hIni and h < hFin) : (h >= hIni or h < hFin))

// ─── acumulación y cierre de la sesión ────────────────────────────────────
var float acHi = na
var float acLo = na
var float niHi = na
var float niLo = na
var int   nDia = 0

empieza = enAsia and not enAsia[1]
acaba   = not enAsia and enAsia[1]

if empieza
    acHi := high
    acLo := low
else if enAsia
    acHi := math.max(nz(acHi, high), high)
    acLo := math.min(nz(acLo, low),  low)

if acaba
    niHi := acHi
    niLo := acLo
    nDia += 1

// ─── dibujo ───────────────────────────────────────────────────────────────
plot(niHi, "Alto de Asia",   color = cAlto, linewidth = grosor, style = plot.style_linebr)
plot(niLo, "Mínimo de Asia", color = cBajo, linewidth = grosor, style = plot.style_linebr)
plot(verMed ? (niHi + niLo) / 2 : na, "Mitad del rango",
     color = color.new(cAlto, 55), linewidth = 1, style = plot.style_linebr)

tam = tamEtq == "Diminuto" ? size.tiny : tamEtq == "Pequeño" ? size.small : size.normal

if acaba and verEtq and nDia > 0
    rango = (niHi - niLo) / pip
    txtA = str.tostring(niHi, format.mintick) + (verRango ? "  ·  " + str.tostring(rango, "#.0") + " p" : "")
    label.new(bar_index, niHi, txtA, style = label.style_label_down,
         color = color.new(cAlto, 88), textcolor = cAlto, size = tam)
    label.new(bar_index, niLo, str.tostring(niLo, format.mintick), style = label.style_label_up,
         color = color.new(cBajo, 88), textcolor = cBajo, size = tam)

// ─── tabla de consulta rápida ─────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islast and not na(niHi)
    table.cell(t, 0, 0, "ASIA", text_color = cAlto, text_size = size.small,
         bgcolor = color.new(cAlto, 90))
    table.cell(t, 1, 0, str.format("{0}:00-{1}:00", hIni, hFin), text_size = size.small,
         text_color = color.gray, bgcolor = color.new(cAlto, 90))
    table.cell(t, 0, 1, "alto",   text_size = size.small, text_color = color.gray)
    table.cell(t, 1, 1, str.tostring(niHi, format.mintick), text_size = size.small)
    table.cell(t, 0, 2, "mínimo", text_size = size.small, text_color = color.gray)
    table.cell(t, 1, 2, str.tostring(niLo, format.mintick), text_size = size.small)
    table.cell(t, 0, 3, "rango",  text_size = size.small, text_color = color.gray)
    table.cell(t, 1, 3, str.tostring((niHi - niLo) / pip, "#.0") + " p", text_size = size.small)
    table.cell(t, 0, 4, "días",   text_size = size.small, text_color = color.gray)
    table.cell(t, 1, 4, str.tostring(nDia), text_size = size.small)

// ─── avisos ───────────────────────────────────────────────────────────────
alertcondition(ta.crossover(close, niHi),  "Cierra por encima del alto de Asia")
alertcondition(ta.crossunder(close, niLo), "Cierra por debajo del mínimo de Asia")
