//@version=6
// ═════════════════════════════════════════════════════════════════════════════
//  CRT · MESA DE TRABAJO
//
//  Todo junto para marcar setups a mano:
//     · Sesiones de Asia, Londres y Nueva York, con sus máximos y mínimos
//     · FVG del marco que elijas, con LOS TRES NIVELES DE ENTRADA dibujados
//     · Panel de 3 velas de H4 y H1 con el rango efectivo (velas internas)
//     · Máximo y mínimo del día anterior
//
//  SOBRE EL FVG. Un FVG no es una señal de entrada: es una ZONA DE ESPERA. Se
//  forma, el precio se va, y la entrada llega cuando VUELVE al hueco. Por eso el
//  indicador dibuja dentro de cada FVG los tres sitios donde se puede entrar:
//  borde cercano (se llena casi siempre, peor precio), 50 % (el estándar), y
//  borde lejano (mejor precio, se llena poco, y si lo pasa el FVG queda anulado).
//
//  Las tres velas del FVG se leen YA CERRADAS. No repinta.
// ═════════════════════════════════════════════════════════════════════════════
indicator("CRT · Mesa de trabajo", "CRT mesa", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ── SESIONES ────────────────────────────────────────────────────────────────
gS = "Sesiones"
verSes  = input.bool(true, "Dibujar sesiones", group = gS)
sAsia   = input.session("1800-0100:23456", "Asia   (hora de Nueva York)", group = gS)
sLon    = input.session("0200-0800:23456", "Londres", group = gS)
sNY     = input.session("0800-1400:23456", "Nueva York", group = gS)
nSes    = input.int(8, "Cuántas sesiones guardar de cada una", minval = 1, maxval = 40, group = gS)
verNivS = input.bool(true, "Extender máximo y mínimo hasta que los barra", group = gS)

// ── FVG ─────────────────────────────────────────────────────────────────────
gF = "Fair Value Gap"
verFVG  = input.bool(true, "Dibujar FVG", group = gF)
tfFVG   = input.timeframe("15", "Marco del FVG", group = gF)
nFVG    = input.int(12, "Cuántos guardar", minval = 1, maxval = 40, group = gF)
minFVG  = input.float(0.0, "Tamaño mínimo del hueco (ticks, 0 = sin filtro)",
     minval = 0.0, step = 0.5, group = gF)
verNiv  = input.bool(true, "Dibujar los tres niveles de entrada", group = gF)
borrarLleno = input.bool(true, "Quitar el FVG cuando se rellena del todo", group = gF)

// ── PANEL CRT ───────────────────────────────────────────────────────────────
gP = "Panel de 3 velas"
verPanel = input.bool(true, "Dibujar panel", group = gP)
verH4    = input.bool(true, "H4", group = gP, inline = "tf")
verH1    = input.bool(true, "H1", group = gP, inline = "tf")
sepIni   = input.int(6,  "Separación del precio (barras)", minval = 1, maxval = 60, group = gP)
anchoV   = input.int(5,  "Ancho de vela (barras)", minval = 1, maxval = 14, group = gP)
huecoV   = input.int(3,  "Hueco entre velas", minval = 0, maxval = 10, group = gP)
huecoG   = input.int(10, "Hueco entre H4 y H1", minval = 2, maxval = 40, group = gP)

gR = "Rangos internos"
maxInt    = input.int(6, "Máximo de velas internas que absorbe", minval = 0, maxval = 12, group = gR,
     tooltip = "0 lo desactiva: la Vela 1 es siempre la anterior a la del barrido, como en el backtest.")
enGrafico = input.bool(true, "Llevar el rango efectivo de H4 al gráfico", group = gR)

gA = "Rejilla H4"
anclaH = input.int(1, "El bloque H4 empieza a las", minval = 0, maxval = 23, group = gA,
     tooltip = "1 con huso de Nueva York = la rejilla de la guía CRT. En hora española: 03,07,11,15,19,23.")
tzRef  = input.string("America/New_York", "Huso de referencia", group = gA,
     options = ["America/New_York", "Europe/Madrid", "UTC"])

gD = "Día anterior"
verDia   = input.bool(true,  "Máximo y mínimo", group = gD)
diaAncla = input.bool(false, "Cortar el día con el anclaje de la rejilla", group = gD)

gC = "Colores"
cAl   = input.color(#2E9E85, "Alcista", group = gC, inline = "c1")
cBa   = input.color(#C0563A, "Bajista", group = gC, inline = "c1")
cViv  = input.color(#3D7FD6, "Vela en curso", group = gC)
cRng  = input.color(#8E6BC4, "Rango efectivo H4", group = gC)
cDia  = input.color(#C9821B, "Día anterior", group = gC)
cAsia = input.color(#8A8F98, "Asia", group = gC, inline = "c2")
cLon  = input.color(#4C7FC4, "Londres", group = gC, inline = "c2")
cNY   = input.color(#D08A3C, "Nueva York", group = gC, inline = "c2")

// ── tiempo local ────────────────────────────────────────────────────────────
tLocal = timestamp("UTC", year(time, tzRef), month(time, tzRef), dayofmonth(time, tzRef),
     hour(time, tzRef), minute(time, tzRef), 0)
MS_H1 = 3600000
MS_H4 = 14400000
MS_D  = 86400000
idH1 = math.floor(tLocal / MS_H1)
idH4 = math.floor((tLocal - anclaH * MS_H1) / MS_H4)
idD  = math.floor((tLocal - (diaAncla ? anclaH : 0) * MS_H1) / MS_D)

f_hhmm(int t) =>
    str.format("{0,number,00}:{1,number,00}", hour(t, "UTC"), minute(t, "UTC"))

// ═══ SESIONES ══════════════════════════════════════════════════════════════
type Sesion
    float alto
    float bajo
    box   caja
    line  lnA
    line  lnB
    bool  muertoA
    bool  muertoB

var array<Sesion> sesiones = array.new<Sesion>()

f_podaSes() =>
    while array.size(sesiones) > nSes * 3
        s = array.shift(sesiones)
        box.delete(s.caja)
        line.delete(s.lnA)
        line.delete(s.lnB)

f_sesion(bool dentro, bool antes, color col) =>
    var Sesion cur = na
    if dentro and not antes
        cj = box.new(bar_index, high, bar_index, low, bgcolor = color.new(col, 93),
             border_color = color.new(col, 55), border_width = 1)
        la = line.new(bar_index, high, bar_index, high, color = color.new(col, 20), width = 1)
        lb = line.new(bar_index, low,  bar_index, low,  color = color.new(col, 20), width = 1)
        cur := Sesion.new(high, low, cj, la, lb, false, false)
        array.push(sesiones, cur)
        f_podaSes()
    if dentro and not na(cur)
        cur.alto := math.max(cur.alto, high)
        cur.bajo := math.min(cur.bajo, low)
        box.set_top(cur.caja, cur.alto)
        box.set_bottom(cur.caja, cur.bajo)
        box.set_right(cur.caja, bar_index)
        line.set_xy2(cur.lnA, bar_index, cur.alto)
        line.set_xy2(cur.lnB, bar_index, cur.bajo)
        line.set_xy1(cur.lnA, line.get_x1(cur.lnA), cur.alto)
        line.set_xy1(cur.lnB, line.get_x1(cur.lnB), cur.bajo)

// se calculan en ambito global: el historial [1] de una variable declarada
// dentro de un if no es de fiar en Pine.
inA = verSes and not na(time(timeframe.period, sAsia, "America/New_York"))
inL = verSes and not na(time(timeframe.period, sLon,  "America/New_York"))
inN = verSes and not na(time(timeframe.period, sNY,   "America/New_York"))
f_sesion(inA, nz(inA[1], false), cAsia)
f_sesion(inL, nz(inL[1], false), cLon)
f_sesion(inN, nz(inN[1], false), cNY)

// extender los niveles de sesión hasta que el precio los barra
if verSes and verNivS and array.size(sesiones) > 0
    for i = 0 to array.size(sesiones) - 1
        s = array.get(sesiones, i)
        if not s.muertoA
            if high > s.alto
                s.muertoA := true
                line.set_color(s.lnA, color.new(color.gray, 70))
            else
                line.set_x2(s.lnA, bar_index)
        if not s.muertoB
            if low < s.bajo
                s.muertoB := true
                line.set_color(s.lnB, color.new(color.gray, 70))
            else
                line.set_x2(s.lnB, bar_index)

// ═══ FVG ═══════════════════════════════════════════════════════════════════
type Hueco
    float alto
    float bajo
    bool  alcista
    box   caja
    line  n1
    line  n2
    line  n3
    label et
    bool  tocado
    bool  lleno

var array<Hueco> huecos = array.new<Hueco>()

// las tres velas del FVG, TODAS CERRADAS: A = [3], B = [2], C = [1]
[fAh, fAl, fCh, fCl] = request.security(syminfo.tickerid, tfFVG,
     [high[3], low[3], high[1], low[1]], lookahead = barmerge.lookahead_off)
nuevaVela = ta.change(time(tfFVG)) != 0

f_podaFVG() =>
    while array.size(huecos) > nFVG
        h = array.shift(huecos)
        box.delete(h.caja)
        line.delete(h.n1)
        line.delete(h.n2)
        line.delete(h.n3)
        label.delete(h.et)

// cuantas barras del grafico ocupa una vela del marco del FVG
razonTF = math.max(1, int(timeframe.in_seconds(tfFVG) / timeframe.in_seconds()))

f_nuevoHueco(float alto, float bajo, bool alc) =>
    col = alc ? cAl : cBa
    // el hueco se formo entre las velas [3] y [1] del marco superior, asi que la
    // caja empieza ahi, no donde lo detectamos
    xIzq = math.max(0, bar_index - 3 * razonTF)
    cj = box.new(xIzq, alto, bar_index + 20, bajo, bgcolor = color.new(col, 88),
         border_color = color.new(col, 55), border_width = 1)
    // borde cercano, 50 % y borde lejano según la dirección
    cerca = alc ? alto : bajo
    lejos = alc ? bajo : alto
    medio = (alto + bajo) / 2
    a = line.new(xIzq, cerca, bar_index + 20, cerca, color = color.new(col, 30),
         width = 1, style = line.style_dotted)
    b = line.new(xIzq, medio, bar_index + 20, medio, color = color.new(col, 10),
         width = 1, style = line.style_solid)
    c = line.new(xIzq, lejos, bar_index + 20, lejos, color = color.new(col, 30),
         width = 1, style = line.style_dotted)
    e = label.new(xIzq, alc ? bajo : alto,
         (alc ? "FVG ALCISTA" : "FVG BAJISTA") + "\nespera a que vuelva",
         style = alc ? label.style_label_up : label.style_label_down,
         color = color.new(color.gray, 100), textcolor = color.new(col, 10),
         size = size.tiny, textalign = text.align_left)
    h = Hueco.new(alto, bajo, alc, cj, a, b, c, e, false, false)
    array.push(huecos, h)
    f_podaFVG()

if verFVG and nuevaVela and not na(fAh) and not na(fCl)
    if fCl > fAh and (fCl - fAh) >= minFVG * syminfo.mintick
        f_nuevoHueco(fCl, fAh, true)
    if fCh < fAl and (fAl - fCh) >= minFVG * syminfo.mintick
        f_nuevoHueco(fAl, fCh, false)

// seguimiento: extender, marcar cuando el precio vuelve, y cerrar al rellenarse
if verFVG and array.size(huecos) > 0
    for i = 0 to array.size(huecos) - 1
        h = array.get(huecos, i)
        if not h.lleno
            box.set_right(h.caja, bar_index + 10)
            line.set_x2(h.n1, bar_index + 10)
            line.set_x2(h.n2, bar_index + 10)
            line.set_x2(h.n3, bar_index + 10)
            if not verNiv
                line.set_color(h.n1, color.new(color.gray, 100))
                line.set_color(h.n2, color.new(color.gray, 100))
                line.set_color(h.n3, color.new(color.gray, 100))
            volvio = h.alcista ? low <= h.alto : high >= h.bajo
            if volvio and not h.tocado
                h.tocado := true
                label.set_text(h.et, (h.alcista ? "FVG ALCISTA" : "FVG BAJISTA") + "\nZONA ACTIVA")
                box.set_bgcolor(h.caja, color.new(h.alcista ? cAl : cBa, 80))
            relleno = h.alcista ? low <= h.bajo : high >= h.alto
            if relleno
                h.lleno := true
                if borrarLleno
                    box.delete(h.caja)
                    line.delete(h.n1)
                    line.delete(h.n2)
                    line.delete(h.n3)
                    label.delete(h.et)
                else
                    box.set_bgcolor(h.caja, color.new(color.gray, 93))
                    label.set_text(h.et, "FVG relleno")

// ═══ ACUMULACIÓN H4 Y H1 PARA EL PANEL ═════════════════════════════════════
HIST = 14
var array<float> aO4 = array.new<float>()
var array<float> aH4 = array.new<float>()
var array<float> aL4 = array.new<float>()
var array<float> aC4 = array.new<float>()
var array<int>   aT4 = array.new<int>()
var float o4 = na
var float h4 = na
var float l4 = na
var float c4 = na
var int   t4 = na

if na(idH4[1]) or idH4 != idH4[1]
    if not na(o4)
        array.push(aO4, o4)
        array.push(aH4, h4)
        array.push(aL4, l4)
        array.push(aC4, c4)
        array.push(aT4, t4)
        if array.size(aO4) > HIST
            array.shift(aO4)
            array.shift(aH4)
            array.shift(aL4)
            array.shift(aC4)
            array.shift(aT4)
    o4 := open
    h4 := high
    l4 := low
    t4 := int((idH4 * MS_H4) + anclaH * MS_H1)
else
    h4 := math.max(h4, high)
    l4 := math.min(l4, low)
c4 := close

var array<float> aO1 = array.new<float>()
var array<float> aH1 = array.new<float>()
var array<float> aL1 = array.new<float>()
var array<float> aC1 = array.new<float>()
var array<int>   aT1 = array.new<int>()
var float o1 = na
var float h1 = na
var float l1 = na
var float c1 = na
var int   t1 = na

if na(idH1[1]) or idH1 != idH1[1]
    if not na(o1)
        array.push(aO1, o1)
        array.push(aH1, h1)
        array.push(aL1, l1)
        array.push(aC1, c1)
        array.push(aT1, t1)
        if array.size(aO1) > HIST
            array.shift(aO1)
            array.shift(aH1)
            array.shift(aL1)
            array.shift(aC1)
            array.shift(aT1)
    o1 := open
    h1 := high
    l1 := low
    t1 := int(idH1 * MS_H1)
else
    h1 := math.max(h1, high)
    l1 := math.min(l1, low)
c1 := close

// rango efectivo: retrocede mientras la vela sea interna a la anterior
f_rango(array<float> ah, array<float> al) =>
    n = array.size(ah)
    idx = n - 2
    dentro = 0
    if idx > 0
        seguir = true
        while seguir and dentro < maxInt and idx > 0
            esInterna = array.get(ah, idx) <= array.get(ah, idx - 1) and
                 array.get(al, idx) >= array.get(al, idx - 1)
            if esInterna
                idx -= 1
                dentro += 1
            else
                seguir := false
    [idx, dentro]

// ═══ DIBUJO DEL PANEL ══════════════════════════════════════════════════════
var array<box>   pBox = array.new<box>()
var array<line>  pLin = array.new<line>()
var array<label> pLab = array.new<label>()

f_limpiaPanel() =>
    while array.size(pBox) > 0
        box.delete(array.pop(pBox))
    while array.size(pLin) > 0
        line.delete(array.pop(pLin))
    while array.size(pLab) > 0
        label.delete(array.pop(pLab))

f_velaP(int xi, float vo, float vh, float vl, float vc, int vt, bool viva, string tag) =>
    col = viva ? cViv : (vc >= vo ? cAl : cBa)
    xc  = xi + int(anchoV / 2)
    b = box.new(xi, math.max(vo, vc), xi + anchoV, math.min(vo, vc),
         border_color = col, border_width = 1, bgcolor = color.new(col, viva ? 55 : 20))
    m = line.new(xc, vh, xc, vl, color = col, width = 2)
    array.push(pBox, b)
    array.push(pLin, m)
    e = label.new(xc, vl, tag + "\n" + f_hhmm(vt), style = label.style_label_up,
         color = color.new(color.gray, 100), textcolor = color.new(col, 10),
         size = size.tiny, textalign = text.align_center)
    array.push(pLab, e)

f_textoP(int xi, float y, string txt) =>
    e = label.new(xi, y, txt, style = label.style_label_down,
         color = color.new(color.gray, 100), textcolor = color.new(color.gray, 10),
         size = size.small)
    array.push(pLab, e)

f_nivelP(int xi, int xf, float y, string txt) =>
    l = line.new(xi, y, xf, y, color = color.new(cRng, 25), width = 1,
         style = line.style_dashed)
    array.push(pLin, l)
    e = label.new(xf, y, txt, style = label.style_label_left,
         color = color.new(color.gray, 100), textcolor = cRng, size = size.tiny)
    array.push(pLab, e)

f_grupo(int x0, string nom, array<float> ao, array<float> ah, array<float> al,
     array<float> ac, array<int> at, float vo, float vh, float vl, float vc, int vt) =>
    n = array.size(ah)
    paso = anchoV + huecoV
    x = x0
    [idx, dentro] = f_rango(ah, al)
    rAlto = n >= 2 ? array.get(ah, idx) : na
    rBajo = n >= 2 ? array.get(al, idx) : na
    f_textoP(x, math.max(vh, nz(rAlto, vh)),
         nom + (dentro > 0 ? "  ·  " + str.tostring(dentro) + " internas" : ""))
    if n >= 2
        f_velaP(x, array.get(ao, idx), rAlto, rBajo, array.get(ac, idx),
             array.get(at, idx), false, "1")
        x += paso
    if n >= 1
        f_velaP(x, array.get(ao, n - 1), array.get(ah, n - 1), array.get(al, n - 1),
             array.get(ac, n - 1), array.get(at, n - 1), false, "2")
        x += paso
    f_velaP(x, vo, vh, vl, vc, vt, true, "3")
    xFin = x + anchoV
    if not na(rAlto)
        f_nivelP(x0, xFin, rAlto, str.tostring(rAlto, format.mintick))
        f_nivelP(x0, xFin, rBajo, str.tostring(rBajo, format.mintick))
    xFin + huecoG

var float r4Alto = na
var float r4Bajo = na
if array.size(aH4) >= 2
    [i4x, d4x] = f_rango(aH4, aL4)
    r4Alto := array.get(aH4, i4x)
    r4Bajo := array.get(aL4, i4x)

if barstate.islast and verPanel
    f_limpiaPanel()
    x = bar_index + sepIni
    if verH4 and not na(o4)
        x := f_grupo(x, "H4", aO4, aH4, aL4, aC4, aT4, o4, h4, l4, c4, t4)
    if verH1 and not na(o1)
        x := f_grupo(x, "H1", aO1, aH1, aL1, aC1, aT1, o1, h1, l1, c1, t1)

// ═══ NIVELES SOBRE EL GRÁFICO ══════════════════════════════════════════════
var float dh  = na
var float dl  = na
var float pdh = na
var float pdl = na
if na(idD[1]) or idD != idD[1]
    pdh := dh
    pdl := dl
    dh  := high
    dl  := low
else
    dh := math.max(dh, high)
    dl := math.min(dl, low)

plot(verDia ? pdh : na, "Máximo del día anterior", cDia, 1, plot.style_linebr)
plot(verDia ? pdl : na, "Mínimo del día anterior", cDia, 1, plot.style_linebr)
plot(enGrafico ? r4Alto : na, "Rango H4 · techo", cRng, 1, plot.style_linebr)
plot(enGrafico ? r4Bajo : na, "Rango H4 · suelo", cRng, 1, plot.style_linebr)

// ── alertas ─────────────────────────────────────────────────────────────────
alertcondition(not na(r4Alto) and ta.crossover(high, r4Alto),  "Barrido del techo del rango H4")
alertcondition(not na(r4Bajo) and ta.crossunder(low, r4Bajo),  "Barrido del suelo del rango H4")
alertcondition(not na(pdh) and ta.crossover(high, pdh),  "Barrido del máximo del día anterior")
alertcondition(not na(pdl) and ta.crossunder(low, pdl),  "Barrido del mínimo del día anterior")
