// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// at https://mozilla.org/MPL/2.0/
//
//  AMD + FVG  ·  EURUSD en H1
//  La base de estrategia medida el 19-09-2026. Nada que configurar.
//
//  ─────────────────────────────────────────────────────────────────────────
//  LOS CUATRO PASOS
//
//    A  el precio se aprieta: 8 velas de H1 dentro de 0,90 x ATR x raiz(8)
//    M  finta: sale del rango y CIERRA de vuelta dentro
//    F  hueco: en las 5 velas siguientes deja un FVG hacia el otro lado
//    →  ENTRAS al cierre de esa vela
//
//       stop      donde llego la finta
//       objetivo  el borde CONTRARIO de la caja
//       y no se toca nada mas
//
//  ─────────────────────────────────────────────────────────────────────────
//  LO MEDIDO  ·  docs/RESULTADOS_amd_fvg.md
//  EURUSD 2021-2024 y 2026, oro y DAX 2023-2026. Barreras iguales, M1.
//
//    EURUSD H1   n 587   acierto 76,5 %   R:R 0,4   riesgo 25,9 pips
//                coste 5,5 % del riesgo
//                BRUTA +0,1048  IC95 [+0,0412, +0,1684]   NETA +0,0390
//
//    exceso sobre la pura geometria:  EURUSD +6,2   oro +3,7   DAX +3,7
//    la misma regla SIN exigir el FVG:  -11,6  -11,2  -12,6
//
//    y los trece anos-instrumento salen positivos en bruta, sin excepcion.
//
//  ─────────────────────────────────────────────────────────────────────────
//  POR QUE SOLO H1, medido y no opinado
//
//    M15   acierto 59,6 %   riesgo 10,4 p   coste 13,7 %   bruta -0,0994
//    H1    acierto 76,5 %   riesgo 25,9 p   coste  5,5 %   bruta +0,1048
//
//  En M15 sale negativo en los tres mercados. Bajar a M5 a "afinar la entrada"
//  dejaria el stop en 5 pips y el peaje en el 28 %: se carga lo unico que hay.
//  Todo lo que gana esto lo gana por operar ANCHO y POCAS veces.
//
//  ─────────────────────────────────────────────────────────────────────────
//  LO QUE NO ES
//
//  Esto es una BASE, no una estrategia probada. Todo lo de arriba es dentro de
//  muestra: los parametros del rango salieron del estudio del AMD sobre estos
//  mismos datos, y ya se ha mirado el historico entero, asi que no queda ningun
//  corte limpio. La unica prueba honesta que falta es hacia delante.
//
//  Tamano: unas 10 senales al mes. Con 10.000 EUR al 1 % de riesgo son 0,45
//  lotes y unos +467 EUR al ano, con 3 de cada 10 anos en perdidas. No da para
//  vivir y no pretende darlo.
//
//  NO REPINTA: cada cosa se dibuja en la vela en que queda confirmada, cerrada,
//  y no se mueve despues.
//
//@version=6
indicator("AMD + FVG · H1", overlay = true,
     max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

verF = input.bool(true, "Marcar las señales que caducan sin hueco")

float LIMITE = 0.90
int   NR     = 8        // velas del rango
int   ESPM   = 20       // velas para que llegue la finta
int   ESPF   = 5        // velas para que llegue el hueco
int   ESPD   = 20       // velas para que se resuelva
color CA = color.new(#8E8E93, 84)
color CM = #E08A2B
color CE = #3D6FB4
color VERDE = #17914F
color ROJO  = #C23B36

int tfmin = int(math.round(timeframe.in_seconds() / 60.0))

float atr = ta.atr(14)
float altoN = ta.highest(high, NR)
float bajoN = ta.lowest(low, NR)
float normal = atr * math.sqrt(NR)
float ratio = normal > 0 ? (altoN - bajoN) / normal : na
bool esRango = not na(atr) and atr > 0 and ratio <= LIMITE

// 0 buscando · 1 rango vivo · 2 finta hecha, esperando hueco · 3 operacion viva
var int   fase = 0
var float rHi  = na
var float rLo  = na
var int   rConf = 0
var box   caja = na
var int   lado = 0
var float ext  = na
var int   barM = 0
var float ent  = na
var float stp  = na
var float obj  = na
var int   barE = 0
var line  lEnt = na
var line  lStp = na
var line  lObj = na

var int nA = 0
var int nM = 0
var int nE = 0
var int nG = 0
var int nP = 0

bool fvgBaj = high < low[2]
bool fvgAlc = low > high[2]
bool disparo = false

// ─── A ─────────────────────────────────────────────────────────────────────
if fase == 0 and esRango and barstate.isconfirmed
    fase := 1
    rHi := altoN
    rLo := bajoN
    rConf := bar_index
    nA := nA + 1
    caja := box.new(bar_index - NR + 1, rHi, bar_index, rLo, bgcolor = CA,
         border_color = color.new(#8E8E93, 50), border_width = 1)

// ─── M ─────────────────────────────────────────────────────────────────────
else if fase == 1
    if high <= rHi and low >= rLo
        if not na(caja)
            box.set_right(caja, bar_index)
    else
        bool arr = high > rHi and close < rHi and close > rLo
        bool aba = low  < rLo and close > rLo and close < rHi
        if arr or aba
            fase := 2
            lado := arr ? -1 : 1
            ext  := arr ? high : low
            barM := bar_index
            nM := nM + 1
            label.new(bar_index, ext, "M",
                 style = arr ? label.style_label_down : label.style_label_up,
                 color = color.new(CM, 20), textcolor = color.white, size = size.tiny)
        else
            fase := 0
    if fase == 1 and bar_index - rConf > ESPM
        fase := 0

// ─── F · el hueco, y la entrada ────────────────────────────────────────────
else if fase == 2
    ext := lado < 0 ? math.max(ext, high) : math.min(ext, low)
    bool hay = lado < 0 ? fvgBaj : fvgAlc
    if hay
        fase := 3
        ent  := close
        stp  := ext
        obj  := lado < 0 ? rLo : rHi
        barE := bar_index
        nE   := nE + 1
        disparo := true
        lEnt := line.new(bar_index, ent, bar_index + 1, ent, color = CE, width = 2,
             extend = extend.right)
        lStp := line.new(bar_index, stp, bar_index + 1, stp, color = ROJO, width = 1,
             style = line.style_dashed, extend = extend.right)
        lObj := line.new(bar_index, obj, bar_index + 1, obj, color = VERDE, width = 1,
             style = line.style_dashed, extend = extend.right)
        label.new(bar_index, ent, "ENTRA " + str.tostring(ent, format.mintick),
             style = lado < 0 ? label.style_label_up : label.style_label_down,
             color = color.new(CE, 10), textcolor = color.white, size = size.small)
    else if bar_index - barM > ESPF
        fase := 0
        if verF
            label.new(bar_index, lado < 0 ? high : low, "sin hueco",
                 style = lado < 0 ? label.style_label_down : label.style_label_up,
                 color = color.new(#8E8E93, 45), textcolor = color.white,
                 size = size.tiny)

// ─── la operacion ──────────────────────────────────────────────────────────
else if fase == 3
    bool salta = lado < 0 ? high >= stp : low <= stp
    bool llega = lado < 0 ? low  <= obj : high >= obj
    bool caduca = bar_index - barE > ESPD
    if salta or llega or caduca
        // si los dos en la misma vela, cuenta como perdida
        bool gano = llega and not salta
        if gano
            nG := nG + 1
        else
            nP := nP + 1
        color cf = gano ? VERDE : ROJO
        label.new(bar_index, close, gano ? "TP" : (salta ? "SL" : "fuera"),
             style = label.style_label_left, color = color.new(cf, 20),
             textcolor = color.white, size = size.tiny)
        if not na(lEnt)
            line.set_extend(lEnt, extend.none)
            line.set_x2(lEnt, bar_index)
        if not na(lStp)
            line.set_extend(lStp, extend.none)
            line.set_x2(lStp, bar_index)
        if not na(lObj)
            line.set_extend(lObj, extend.none)
            line.set_x2(lObj, bar_index)
        fase := 0

alertcondition(disparo, "AMD+FVG · entrada",
     "AMD+FVG en {{ticker}} {{interval}}: entrada al cierre. Mira el gráfico.")

// ─── la tabla ──────────────────────────────────────────────────────────────
var table T = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    string est = fase == 0 ? "esperando rango" : fase == 1 ? "rango vivo" :
                 fase == 2 ? "FINTA · busca hueco" : "OPERACION VIVA"
    color ce = fase == 2 ? CM : fase == 3 ? CE : color.new(#8E8E93, 30)
    int res = nG + nP
    float ac = res > 0 ? 100.0 * nG / res : 0.0
    table.cell(T, 0, 0, "ESTADO", text_size = size.normal, text_color = color.white,
         bgcolor = ce)
    table.cell(T, 1, 0, est, text_size = size.normal, text_color = color.white,
         bgcolor = ce)
    table.cell(T, 0, 1, "marco", text_size = size.small)
    table.cell(T, 1, 1, timeframe.period + (tfmin == 60 ? "  ✓" : "  ← ponlo en H1"),
         text_size = size.small, text_color = tfmin == 60 ? VERDE : ROJO)
    table.cell(T, 0, 2, "estrechez", text_size = size.small)
    table.cell(T, 1, 2, str.tostring(ratio, "#.##") + "  (pide ≤ 0,90)",
         text_size = size.small)
    table.cell(T, 0, 3, "rangos / fintas", text_size = size.small)
    table.cell(T, 1, 3, str.tostring(nA) + " / " + str.tostring(nM), text_size = size.small)
    table.cell(T, 0, 4, "entradas", text_size = size.small)
    table.cell(T, 1, 4, str.tostring(nE), text_size = size.small)
    table.cell(T, 0, 5, "TP / SL", text_size = size.small)
    table.cell(T, 1, 5, str.tostring(nG) + " / " + str.tostring(nP), text_size = size.small)
    table.cell(T, 0, 6, "acierto", text_size = size.small)
    table.cell(T, 1, 6, res > 0 ? str.tostring(ac, "#.#") + " %  (medido 76,5)" : "—",
         text_size = size.small, text_color = res > 0 and ac >= 76.5 ? VERDE : color.gray)
