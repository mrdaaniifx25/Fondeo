//@version=5
// CRT operativo · Fondeo
//
// Las reglas son EXACTAMENTE las que quedaron medidas en el repositorio.
// Nada de adornos: no hay medias, ni fibos, ni filtros de sesion, porque
// ninguno de los que se probaron aporto nada.
//
//   rango         la vela ANTERIOR ya cerrada
//   manipulacion  la vela actual barre un extremo y CIERRA de vuelta dentro
//   entrada       al cierre de esa vela            (agresiva gana 19/20)
//   stop          el extremo del BARRIDO           (liquidacion gana 19/20)
//   objetivo      extension del 150 % del rango, o el extremo opuesto
//
// La tabla calcula la estadistica DELANTE DE TI sobre el instrumento y el
// periodo que tengas cargado, y pone al lado la linea del azar geometrico.
// Si la columna REAL no supera a la columna AZAR, no hay ventaja. Punto.
//
// Recomendado: grafico de 12 HORAS. Es la unica temporalidad donde el coste
// baja del 4 % del riesgo. En M15 o H1 el coste se come cualquier ventaja.

indicator("CRT operativo · Fondeo", overlay = true,
     max_labels_count = 500, max_lines_count = 500)

grpR = "Reglas"
modoObj = input.string("Extension 150%", "Objetivo",
     options = ["Extension 150%", "Extremo opuesto"], group = grpR)
velasMax = input.int(3, "Velas para resolver", minval = 1, maxval = 20, group = grpR)

grpC = "Coste"
pipMan = input.float(0.0, "Tamano del pip (0 = automatico)", group = grpC)
costePips = input.float(1.43, "Coste ida y vuelta, en pips", step = 0.01, group = grpC,
     tooltip = "Medido: EURUSD 1,43 · GBPUSD 1,60 · USDJPY 1,50. " +
               "USDCAD no esta medido, prueba 2,0.")

grpV = "Vista"
verNiveles = input.bool(true, "Dibujar entrada / stop / objetivo", group = grpV)
verTabla = input.bool(true, "Tabla de estadistica", group = grpV)

pip = pipMan > 0 ? pipMan : syminfo.mintick * 10

// ---------------------------------------------------------------- estado
var float[] eEnt  = array.new_float()
var float[] eStop = array.new_float()
var float[] eObj  = array.new_float()
var int[]   eDir  = array.new_int()
var int[]   eBar  = array.new_int()
var int[]   eEst  = array.new_int()      // 0 abierta · 1 objetivo · -1 stop · 2 vencida
var float[] eR    = array.new_float()
var float[] eRR   = array.new_float()
var float[] eCos  = array.new_float()

// ------------------------------------------- 1 · resolver lo que hay abierto
if barstate.isconfirmed
    for i = 0 to math.max(array.size(eEnt) - 1, 0)
        if array.size(eEnt) > 0 and array.get(eEst, i) == 0 and bar_index > array.get(eBar, i)
            d = array.get(eDir, i)
            e = array.get(eEnt, i)
            s = array.get(eStop, i)
            o = array.get(eObj, i)
            rgo = math.abs(e - s)
            tocaStop = d > 0 ? low <= s : high >= s
            tocaObj  = d > 0 ? high >= o : low <= o
            if tocaStop                                   // conservador: si ambos, manda el stop
                array.set(eEst, i, -1)
                array.set(eR, i, -1.0)
            else if tocaObj
                array.set(eEst, i, 1)
                array.set(eR, i, math.abs(o - e) / rgo)
            else if bar_index - array.get(eBar, i) >= velasMax
                array.set(eEst, i, 2)                     // vencida: se valora a mercado
                array.set(eR, i, (close - e) * d / rgo)

// ------------------------------------------------------ 2 · buscar la senal
rango = high[1] - low[1]
dir = 0
if barstate.isconfirmed and rango > 0
    if high > high[1] and close < high[1]
        dir := -1
    else if low < low[1] and close > low[1]
        dir := 1

ent = close
stp = dir > 0 ? low : high
rgo = math.abs(ent - stp)
obj = modoObj == "Extension 150%" ? ent + 1.5 * rango * dir : (dir > 0 ? high[1] : low[1])
valida = dir != 0 and rgo >= 2 * pip and (obj - ent) * dir > 0

if valida
    array.push(eEnt, ent)
    array.push(eStop, stp)
    array.push(eObj, obj)
    array.push(eDir, dir)
    array.push(eBar, bar_index)
    array.push(eEst, 0)
    array.push(eR, 0.0)
    array.push(eRR, math.abs(obj - ent) / rgo)
    array.push(eCos, costePips * pip / rgo)

    txt = (dir > 0 ? "COMPRA" : "VENTA") +
          "\nentrada " + str.tostring(ent, format.mintick) +
          "\nstop "    + str.tostring(stp, format.mintick) +
          "\nobjetivo "+ str.tostring(obj, format.mintick) +
          "\nR:R "     + str.tostring(math.abs(obj - ent) / rgo, "#.##") +
          "  ·  riesgo " + str.tostring(rgo / pip, "#.#") + " pips" +
          "\ncoste "   + str.tostring(costePips * pip / rgo * 100, "#.#") + " % del riesgo"
    label.new(bar_index, dir > 0 ? low : high, txt,
         style = dir > 0 ? label.style_label_up : label.style_label_down,
         color = dir > 0 ? color.new(color.teal, 15) : color.new(color.maroon, 15),
         textcolor = color.white, size = size.small)

    if verNiveles
        line.new(bar_index, ent, bar_index + velasMax, ent,
             color = color.new(color.gray, 30), width = 1)
        line.new(bar_index, stp, bar_index + velasMax, stp,
             color = color.new(color.red, 20), width = 1, style = line.style_dashed)
        line.new(bar_index, obj, bar_index + velasMax, obj,
             color = color.new(color.green, 20), width = 1, style = line.style_dashed)

// ------------------------------------------------------------- 3 · la tabla
if verTabla and barstate.islast
    int n = 0, int gan = 0, int per = 0, int ven = 0
    float sR = 0.0, float sN = 0.0, float sRR = 0.0, float sGeo = 0.0
    if array.size(eEnt) > 0
        for i = 0 to array.size(eEnt) - 1
            if array.get(eEst, i) != 0
                n += 1
                r = array.get(eR, i)
                sR += r
                sN += r - array.get(eCos, i)
                sRR += array.get(eRR, i)
                sGeo += 1.0 / (1.0 + array.get(eRR, i))
                if array.get(eEst, i) == 1
                    gan += 1
                else if array.get(eEst, i) == -1
                    per += 1
                else
                    ven += 1

    var table t = table.new(position.top_right, 2, 10,
         border_width = 1, border_color = color.new(color.gray, 60))
    f(row, a, b, destaca) =>
        table.cell(t, 0, row, a, text_halign = text.align_left, text_size = size.small,
             text_color = color.new(color.white, 0), bgcolor = color.new(color.black, 25))
        table.cell(t, 1, row, b, text_halign = text.align_right, text_size = size.small,
             text_color = destaca ? color.yellow : color.new(color.white, 0),
             bgcolor = color.new(color.black, 25))

    f(0, "CRT · " + syminfo.ticker + " " + timeframe.period, str.tostring(n) + " senales", false)
    f(1, "objetivo alcanzado", str.tostring(gan), false)
    f(2, "stop", str.tostring(per), false)
    f(3, "vencida a mercado", str.tostring(ven), false)
    f(4, "R:R medio", n > 0 ? str.tostring(sRR / n, "#.##") : "-", false)
    f(5, "ACIERTO real", n > 0 ? str.tostring(gan / n * 100, "#.#") + " %" : "-", true)
    f(6, "acierto por AZAR", n > 0 ? str.tostring(sGeo / n * 100, "#.#") + " %" : "-", false)
    f(7, "R media BRUTA", n > 0 ? str.tostring(sR / n, "+#.####") : "-", false)
    f(8, "R media NETA", n > 0 ? str.tostring(sN / n, "+#.####") : "-", true)
    f(9, "total en R", n > 0 ? str.tostring(sN, "+#.#") + " R" : "-", true)
