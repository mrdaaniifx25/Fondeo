//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  VELAS MTF EN PANEL + DÍA ANTERIOR
//
//  Las velas de H1 y H4 se dibujan en un panel a la DERECHA del precio, no
//  encima. Se actualizan en vivo: la última vela de cada grupo es la que está
//  formándose ahora mismo. Como comparten escala de precio con el gráfico, ves
//  de un vistazo dónde queda el precio actual dentro del rango H4.
//
//  El máximo y el mínimo del día anterior sí van sobre el gráfico, porque son
//  niveles y ahí es donde sirven.
//
//  La rejilla H4 es CONFIGURABLE. Por defecto va anclada a la 01:00 de Nueva
//  York, que es la de la guía CRT (velas de 1am y 5am EST). En hora española:
//  03:00, 07:00, 11:00, 15:00, 19:00 y 23:00.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Velas MTF en panel + Día anterior", "MTF panel", overlay = true,
     max_boxes_count  = 500,
     max_lines_count  = 500,
     max_labels_count = 500)

// ── entradas ────────────────────────────────────────────────────────────────
gP = "Panel de velas"
verH4   = input.bool(true, "Velas H4", group = gP, inline = "tf")
verH1   = input.bool(true, "Velas H1", group = gP, inline = "tf")
nMost   = input.int(6, "Cuántas mostrar de cada marco", minval = 2, maxval = 20, group = gP)
sepIni  = input.int(6, "Separación del precio (barras)", minval = 1, maxval = 60, group = gP)
anchoV  = input.int(4, "Ancho de cada vela (barras)", minval = 1, maxval = 12, group = gP)
huecoV  = input.int(2, "Hueco entre velas (barras)", minval = 0, maxval = 8, group = gP)
huecoG  = input.int(8, "Hueco entre los dos grupos (barras)", minval = 2, maxval = 40, group = gP)
verHora = input.bool(true, "Poner la hora debajo de cada vela", group = gP)

gA = "Rejilla H4"
anclaH = input.int(1, "El bloque H4 empieza a las", minval = 0, maxval = 23, group = gA,
     tooltip = "1 con huso de Nueva York = la rejilla de la guía CRT (01,05,09,13,17,21 NY). En hora española: 03,07,11,15,19,23.")
tzRef  = input.string("America/New_York", "Huso de referencia", group = gA,
     options = ["America/New_York", "Europe/Madrid", "UTC"])

gD = "Día anterior (sobre el gráfico)"
verDia   = input.bool(true,  "Marcar máximo y mínimo", group = gD)
diaAncla = input.bool(false, "Cortar el día con el mismo anclaje que la rejilla H4", group = gD)

gC = "Colores"
cAl  = input.color(#2E9E85, "Alcista", group = gC, inline = "c1")
cBa  = input.color(#C0563A, "Bajista", group = gC, inline = "c1")
cViv = input.color(#3D7FD6, "Vela en curso", group = gC)
cDia = input.color(#C9821B, "Día anterior", group = gC)

// ── troceado por husos ──────────────────────────────────────────────────────
tLocal = timestamp("UTC", year(time, tzRef), month(time, tzRef), dayofmonth(time, tzRef),
     hour(time, tzRef), minute(time, tzRef), 0)

MS_H1 = 3600000
MS_H4 = 14400000
MS_D  = 86400000

idH1 = math.floor(tLocal / MS_H1)
idH4 = math.floor((tLocal - anclaH * MS_H1) / MS_H4)
idD  = math.floor((tLocal - (diaAncla ? anclaH : 0) * MS_H1) / MS_D)

// ═══ ACUMULACIÓN DE VELAS H4 ═══════════════════════════════════════════════
var array<float> aO4 = array.new<float>()
var array<float> aH4 = array.new<float>()
var array<float> aL4 = array.new<float>()
var array<float> aC4 = array.new<float>()
var array<int>   aT4 = array.new<int>()
var float o4 = na
var float h4 = na
var float l4 = na
var float c4 = na
var int   t4 = na

if na(idH4[1]) or idH4 != idH4[1]
    if not na(o4)
        array.push(aO4, o4)
        array.push(aH4, h4)
        array.push(aL4, l4)
        array.push(aC4, c4)
        array.push(aT4, t4)
        if array.size(aO4) > nMost
            array.shift(aO4)
            array.shift(aH4)
            array.shift(aL4)
            array.shift(aC4)
            array.shift(aT4)
    o4 := open
    h4 := high
    l4 := low
    t4 := int((idH4 * MS_H4) + anclaH * MS_H1)
else
    h4 := math.max(h4, high)
    l4 := math.min(l4, low)
c4 := close

// ═══ ACUMULACIÓN DE VELAS H1 ═══════════════════════════════════════════════
var array<float> aO1 = array.new<float>()
var array<float> aH1 = array.new<float>()
var array<float> aL1 = array.new<float>()
var array<float> aC1 = array.new<float>()
var array<int>   aT1 = array.new<int>()
var float o1 = na
var float h1 = na
var float l1 = na
var float c1 = na
var int   t1 = na

if na(idH1[1]) or idH1 != idH1[1]
    if not na(o1)
        array.push(aO1, o1)
        array.push(aH1, h1)
        array.push(aL1, l1)
        array.push(aC1, c1)
        array.push(aT1, t1)
        if array.size(aO1) > nMost
            array.shift(aO1)
            array.shift(aH1)
            array.shift(aL1)
            array.shift(aC1)
            array.shift(aT1)
    o1 := open
    h1 := high
    l1 := low
    t1 := int(idH1 * MS_H1)
else
    h1 := math.max(h1, high)
    l1 := math.min(l1, low)
c1 := close

// ═══ DIBUJO DEL PANEL ══════════════════════════════════════════════════════
f_hhmm(int t) =>
    str.format("{0,number,00}:{1,number,00}", hour(t, "UTC"), minute(t, "UTC"))

var array<box>   pBox = array.new<box>()
var array<line>  pLin = array.new<line>()
var array<label> pLab = array.new<label>()

f_limpia() =>
    while array.size(pBox) > 0
        box.delete(array.pop(pBox))
    while array.size(pLin) > 0
        line.delete(array.pop(pLin))
    while array.size(pLab) > 0
        label.delete(array.pop(pLab))

// dibuja una vela en la posición x indicada
f_vela(int xi, float vo, float vh, float vl, float vc, int vt, bool viva) =>
    col = viva ? cViv : (vc >= vo ? cAl : cBa)
    xd  = xi + anchoV
    xc  = xi + int(anchoV / 2)
    b = box.new(xi, math.max(vo, vc), xd, math.min(vo, vc),
         border_color = col, border_width = 1, bgcolor = color.new(col, viva ? 55 : 20))
    m = line.new(xc, vh, xc, vl, color = col, width = 2)
    array.push(pBox, b)
    array.push(pLin, m)
    if verHora
        e = label.new(xc, vl, f_hhmm(vt), style = label.style_label_up,
             color = color.new(color.gray, 100), textcolor = color.new(col, 20),
             size = size.tiny)
        array.push(pLab, e)

f_titulo(int xi, float y, string txt) =>
    e = label.new(xi, y, txt, style = label.style_label_down,
         color = color.new(color.gray, 100), textcolor = color.new(color.gray, 10),
         size = size.small)
    array.push(pLab, e)

if barstate.islast
    f_limpia()
    paso = anchoV + huecoV
    x = bar_index + sepIni
    // Ojo: en Pine "for i = 0 to -1" NO se salta, cuenta hacia atras. Con el
    // array vacio eso pediria el elemento 0 de una lista de cero y reventaria.
    if verH4 and not na(o4)
        n4 = array.size(aO4)
        alto4 = h4
        if n4 > 0
            for i = 0 to n4 - 1
                alto4 := math.max(alto4, array.get(aH4, i))
        f_titulo(x, alto4, "H4")
        if n4 > 0
            for i = 0 to n4 - 1
                f_vela(x, array.get(aO4, i), array.get(aH4, i), array.get(aL4, i),
                     array.get(aC4, i), array.get(aT4, i), false)
                x += paso
        f_vela(x, o4, h4, l4, c4, t4, true)
        x += paso + huecoG
    if verH1 and not na(o1)
        n1 = array.size(aO1)
        alto1 = h1
        if n1 > 0
            for i = 0 to n1 - 1
                alto1 := math.max(alto1, array.get(aH1, i))
        f_titulo(x, alto1, "H1")
        if n1 > 0
            for i = 0 to n1 - 1
                f_vela(x, array.get(aO1, i), array.get(aH1, i), array.get(aL1, i),
                     array.get(aC1, i), array.get(aT1, i), false)
                x += paso
        f_vela(x, o1, h1, l1, c1, t1, true)

// ═══ MÁXIMO Y MÍNIMO DEL DÍA ANTERIOR, SOBRE EL GRÁFICO ════════════════════
var float dh  = na
var float dl  = na
var float pdh = na
var float pdl = na

if na(idD[1]) or idD != idD[1]
    pdh := dh
    pdl := dl
    dh  := high
    dl  := low
else
    dh := math.max(dh, high)
    dl := math.min(dl, low)

plot(verDia ? pdh : na, "Máximo del día anterior", cDia, 1, plot.style_linebr)
plot(verDia ? pdl : na, "Mínimo del día anterior", cDia, 1, plot.style_linebr)

// ── alertas ─────────────────────────────────────────────────────────────────
alertcondition(not na(pdh) and ta.crossover(high, pdh),  "Barrido del máximo del día anterior")
alertcondition(not na(pdl) and ta.crossunder(low, pdl),  "Barrido del mínimo del día anterior")
